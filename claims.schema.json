{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CEA claim record",
  "description": "The record that the extract-claims skill writes for one paper. cea_claims.py validate checks everything this schema cannot.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "claims",
    "excluded",
    "main_results",
    "paper"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "paper": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "pages",
        "pdf",
        "title"
      ],
      "properties": {
        "doi": {
          "type": "string",
          "pattern": "^10\\.\\d{4,9}/[-._;()/:<>#\\[\\]+A-Za-z0-9]+$"
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "maxLength": 200
        },
        "pages": {
          "type": "integer",
          "minimum": 1
        },
        "pdf": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "main_results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "page",
          "quote",
          "section",
          "source"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^R\\d+$"
          },
          "note": {
            "type": "string",
            "minLength": 1
          },
          "page": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1
              },
              {
                "type": "string",
                "pattern": "^\\d+-\\d+$"
              }
            ]
          },
          "quote": {
            "type": "string",
            "minLength": 1
          },
          "section": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "enum": [
              "abstract",
              "contributions",
              "rq_answer",
              "conclusion",
              "other"
            ]
          },
          "states": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "page",
          "quote",
          "section",
          "selection_reason",
          "serves",
          "split_from",
          "states"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^C\\d+$"
          },
          "note": {
            "type": "string",
            "minLength": 1
          },
          "page": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1
              },
              {
                "type": "string",
                "pattern": "^\\d+-\\d+$"
              }
            ]
          },
          "quote": {
            "type": "string",
            "minLength": 1
          },
          "section": {
            "type": "string",
            "minLength": 1
          },
          "selection_reason": {
            "type": "string",
            "minLength": 1
          },
          "serves": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^R\\d+$"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "split_from": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "pattern": "^S\\d+$"
              }
            ]
          },
          "states": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "excluded": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "page",
          "quote",
          "reason",
          "section"
        ],
        "properties": {
          "breaks_down": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^R\\d+$"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "duplicate_of": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[RCE]\\d+$"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "id": {
            "type": "string",
            "pattern": "^E\\d+$"
          },
          "note": {
            "type": "string",
            "minLength": 1
          },
          "page": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1
              },
              {
                "type": "string",
                "pattern": "^\\d+-\\d+$"
              }
            ]
          },
          "quote": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "section": {
            "type": "string",
            "minLength": 1
          },
          "split_from": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "pattern": "^S\\d+$"
              }
            ]
          },
          "states": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
